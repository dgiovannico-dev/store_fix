# FacilityFlow — reverse proxy TLS (US-E14-01 / T5.4)
# FF_DOMAIN: dominio pubblico (staging/prod). Lab locale: localhost → cert interno Caddy.
#
# Client IP / X-Forwarded-*: with Caddy as the public edge (default), reverse_proxy
# ignores inbound XFF spoofing and sets trusted values for `app`.
# If a CDN sits in front of Caddy, uncomment global trusted_proxies (CDN CIDRs)
# + trusted_proxies_strict — see docs/ops/PROXY.md. App rate-limits use
# FF_TRUSTED_PROXY_COUNT (default 1) via clientIpFromHeaders.
#
# {
# 	servers {
# 		trusted_proxies static 173.245.48.0/20 103.21.244.0/22
# 		trusted_proxies_strict
# 	}
# }

{$FF_DOMAIN:localhost} {
	encode gzip zstd

	reverse_proxy app:3000 {
		health_uri /api/health/ready
		health_interval 10s
		health_timeout 5s
		health_status 2xx
		fail_duration 30s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-DNS-Prefetch-Control "off"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# SeaweedFS S3 pubblico (browser PUT/GET firmate). DNS: s3.<FF_DOMAIN>
# App: S3_PUBLIC_ENDPOINT=https://s3.<FF_DOMAIN> (firmare sull'host pubblico — SigV4).
# SeaweedFS: preferibile -s3.externalUrl=$S3_PUBLIC_ENDPOINT su VPS.
s3.{$FF_DOMAIN:localhost} {
	@options {
		method OPTIONS
	}
	handle @options {
		header Access-Control-Allow-Origin "{header.Origin}"
		header Access-Control-Allow-Methods "GET, PUT, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, *"
		header Access-Control-Max-Age "86400"
		header Access-Control-Allow-Credentials "true"
		respond 204
	}

	header Access-Control-Allow-Origin "{header.Origin}"
	header Access-Control-Expose-Headers "ETag, x-amz-request-id"
	header Access-Control-Allow-Credentials "true"

	reverse_proxy seaweedfs:8333 {
		# Host pubblico nella firma SigV4 (non riscrivere a seaweedfs:8333)
		header_up Host {host}
		header_up X-Forwarded-Port {port}
	}

	log {
		output stdout
		format console
	}
}
