# FacilityFlow — copy to .env (never commit .env)
# Dev: .env · Prod VPS: .env.prod (vedi docs/ops/SECRETS.md)
# Compose locale vs prod: docker-compose.yml · compose.prod.yaml

POSTGRES_USER=facilityflow
POSTGRES_PASSWORD=facilityflow_dev
POSTGRES_DB=facilityflow
DATABASE_URL=postgresql://facilityflow:facilityflow_dev@localhost:5432/facilityflow?schema=public

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Prod: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Prod / staging (Caddy Automatic HTTPS) — lab: localhost
FF_DOMAIN=localhost

# SeaweedFS S3 (Compose)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=facilityflow-attachments
S3_FORCE_PATH_STYLE=true
ATTACHMENT_SIGNED_URL_TTL_SECONDS=900

# SMTP — Mailpit in dev; host reale in prod (no Mailpit in compose.prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="FacilityFlow <noreply@facilityflow.local>"
MAILPIT_UI_URL=http://localhost:8025

# F2-08 inbound email → ticket (webhook self-host; leave empty to disable)
# INBOUND_EMAIL_WEBHOOK_SECRET=

# F3-02 GlitchTip observe profile (docker compose --profile observe)
# GLITCHTIP_DB_PASSWORD=glitchtip_dev
# GLITCHTIP_SECRET_KEY=
# GLITCHTIP_DOMAIN=http://localhost:8000
# GLITCHTIP_PORT=8000
# SENTRY_DSN=   # opzionale quando SDK abilitato; DSN self-host GlitchTip

# F3-08 store push (ntfy self-host; leave empty = skip ntfy path)
# NTFY_BASE_URL=https://ntfy.example.com
# NTFY_TOKEN=

# F3-04 IMAP poll → ticket (leave empty = worker skip)
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=
# IMAP_PASS=
# IMAP_MAILBOX=INBOX
# IMAP_TENANT_SLUG=pilot-retail
# IMAP_POLL_CRON=*/2 * * * *
# IMAP_MARK_SEEN=true

# F2-07 AI assist (Ollama locale; leave empty = heuristic only)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
