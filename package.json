{
  "name": "facilityflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:pilot": "tsx prisma/seed-pilot.ts",
    "db:seed:stress": "tsx prisma/seed-stress.ts",
    "worker": "tsx src/workers/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "storage:init": "tsx scripts/seaweed-init.ts",
    "db:backup": "bash scripts/pg-backup.sh",
    "perf:hq-list": "tsx scripts/measure-hq-list-p95.ts",
    "secrets:scan": "bash scripts/secrets-scan.sh",
    "compose:prod:config": "docker compose -f compose.prod.yaml --env-file .env.prod.example config --quiet",
    "compose:lab:config": "docker compose -f compose.prod.yaml -f compose.lab.yaml --env-file .env.prod.example config --quiet",
    "compose:observe:config": "docker compose --profile observe config --quiet",
    "compose:prod:observe:config": "docker compose -f compose.prod.yaml --profile observe --env-file .env.prod.example config --quiet",
    "caddy:validate": "bash scripts/validate-caddyfile.sh",
    "helm:template": "bash scripts/helm-template.sh",
    "platform:onboard": "bash scripts/platform-app-onboard.sh",
    "deploy:migrate:lab": "FF_MODE=lab FF_LAB_MIGRATE_ONLY=1 bash scripts/deploy-migrate.sh",
    "verify:local": "npm run typecheck && npm run lint && npm test && npm run secrets:scan && npm audit --audit-level=high",
    "audit:osv": "bash scripts/osv-scan.sh",
    "smoke:http": "bash scripts/smoke-flusso-a-http.sh",
    "smoke:all-roles": "bash scripts/smoke-all-roles-http.sh",
    "smoke:tour-steps": "bash scripts/smoke-tour-steps.sh",
    "smoke:attachment-put": "bash scripts/smoke-attachment-s3-put.sh",
    "verify:headers": "bash scripts/verify-security-headers.sh",
    "vps:preflight": "bash scripts/vps-preflight.sh",
    "vps:wizard": "bash scripts/vps-setup-wizard.sh",
    "vps:remote-check": "bash scripts/vps-remote-check.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sentry/node": "^11.10.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.10.2",
    "imapflow": "^2.9.1",
    "lucide-react": "^1.68.0",
    "mailparser": "^3.13.0",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "10.3.1",
    "pg-boss": "^12.38.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nodemailer": "10.3.1",
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.32",
    "glob": {
      ".": "14.0.2",
      "minimatch": "11.0.1"
    }
  }
}
