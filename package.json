{
  "name": "facilityflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:pilot": "tsx prisma/seed-pilot.ts",
    "db:seed:stress": "tsx prisma/seed-stress.ts",
    "worker": "tsx src/workers/index.ts",
    "storage:init": "tsx scripts/seaweed-init.ts",
    "db:backup": "bash scripts/pg-backup.sh",
    "perf:hq-list": "tsx scripts/measure-hq-list-p95.ts",
    "secrets:scan": "bash scripts/secrets-scan.sh",
    "compose:prod:config": "docker compose -f compose.prod.yaml --env-file .env.prod.example config --quiet",
    "compose:lab:config": "docker compose -f compose.prod.yaml -f compose.lab.yaml --env-file .env.prod.example config --quiet",
    "compose:observe:config": "docker compose --profile observe config --quiet",
    "compose:prod:observe:config": "docker compose -f compose.prod.yaml --profile observe --env-file .env.prod.example config --quiet",
    "deploy:migrate:lab": "FF_MODE=lab FF_LAB_MIGRATE_ONLY=1 bash scripts/deploy-migrate.sh",
    "verify:local": "npm run typecheck && npm test && npm run secrets:scan",
    "audit:osv": "bash scripts/osv-scan.sh",
    "smoke:http": "bash scripts/smoke-flusso-a-http.sh",
    "smoke:attachment-put": "bash scripts/smoke-attachment-s3-put.sh",
    "verify:headers": "bash scripts/verify-security-headers.sh",
    "vps:preflight": "bash scripts/vps-preflight.sh",
    "vps:wizard": "bash scripts/vps-setup-wizard.sh",
    "vps:remote-check": "bash scripts/vps-remote-check.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/client": "^6.16.2",
    "@sentry/node": "^11.10.0",
    "bcryptjs": "^3.0.3",
    "imapflow": "^2.9.1",
    "mailparser": "^3.13.0",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "10.3.0",
    "pg-boss": "^12.38.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rrule": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nodemailer": "10.3.0",
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.32"
  }
}
