# Copia in /etc/facilityflow/.env.prod (mode 600) — MAI commitare valori reali
# Vedi docs/ops/SECRETS.md

POSTGRES_USER=facilityflow
POSTGRES_PASSWORD=REPLACE_openssl_rand_hex_24
POSTGRES_DB=facilityflow

AUTH_SECRET=REPLACE_openssl_rand_base64_32
FF_DOMAIN=app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
# Solo se Caddy non propaga X-Forwarded-Host correttamente (raro):
# SERVER_ACTIONS_ALLOWED_ORIGINS=app.example.com
# CSP upgrade-insecure-requests (default on with FF_DOMAIN). Docs: SECURITY_HEADERS.md
# FF_CSP_UPGRADE_INSECURE=0
# Auth Secure cookies (default on with https APP_URL / FF_DOMAIN). Docs: AUTH.md
# AUTH_SECURE_COOKIES=0
# Trusted proxy hops for rate-limit IP (Caddy=1). Docs: RATE_LIMITS.md
# FF_TRUSTED_PROXY_COUNT=1
# Shared rate-limit store when scaling app replicas (default memory). Docs: RATE_LIMITS.md
# FF_RATE_LIMIT_STORE=postgres

S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
S3_BUCKET=facilityflow-attachments
# Browser signed URLs (DNS s3.<FF_DOMAIN> → Caddy → SeaweedFS). Required for Flusso A photo upload from UI.
S3_PUBLIC_ENDPOINT=https://s3.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM="FacilityFlow <noreply@example.com>"

# F3-04 IMAP inbound (opzionale — leave empty = poll skip)
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=
# IMAP_PASS=
# IMAP_MAILBOX=INBOX
# IMAP_TENANT_SLUG=pilot-retail

# F3-08 store push (ntfy self-host)
# NTFY_BASE_URL=https://ntfy.example.com
# NTFY_TOKEN=

# F3-02 GlitchTip (docker compose -f compose.prod.yaml --profile observe)
# SENTRY_DSN=http://key@127.0.0.1:8000/1
# GLITCHTIP_DB_PASSWORD=REPLACE
# GLITCHTIP_SECRET_KEY=REPLACE_openssl_rand_hex_32
# GLITCHTIP_DOMAIN=https://errors.example.com
# GLITCHTIP_PORT=8000
